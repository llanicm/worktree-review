{
  "name": "worktree-review",
  "private": true,
  "type": "module",
  "description": "A local, GitHub-style review screen for the git worktrees Claude Code is working in.",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p src/server && tsc -p src/web && tsc -p src/web/worker && tsc -p test",
    "watch": "node build.mjs --watch --out .build",
    "demo": "node build.mjs --out .build && WTR_DIST=.build node extras/demo/demo.mjs",
    "test": "node build.mjs --out .build && WTR_DIST=.build node --test --test-reporter=spec test/*.test.ts",
    "check": "npm run typecheck && npm test",
    "bench": "node build.mjs --out .build && WTR_DIST=.build node test/bench.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "version": "2.4.0"
}
